{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:legacy)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm run db:reset)",
      "Bash(npm run db:up)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push *)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
  "PostToolUse": [{
    "matcher": "Edit|Write",
    "hooks": [{
      "type": "command",
      "command":
        "node .claude/hooks/format-typkoll-lint.mjs"
    },
    {
      "type": "command",
      "command": "node .claude/hooks/block-console-log.mjs"
    }]
  }],
  "SessionStart": [{
  "hooks": [{
    "type": "command",
    "command":
      "node .claude/hooks/las-logg.mjs"
  }]
}],
"SessionEnd": [{
  "hooks": [{
    "type": "command",
    "command":
      "node .claude/hooks/skriv-logg.mjs"
  }]
}],
"PreToolUse": [{
  "matcher": "Edit|Write",
  "hooks": [{
    "type": "command",
    "command": "node .claude/hooks/skydda-env.mjs"
  }]
}]
}
}